# =============================================================================
# 千铝国昱云平台 / platform-api 生产环境变量
# 部署步骤:
#   1) 复制: cp deploy/.env.example /data/guoyu/.env
#   2) 编辑: vi /data/guoyu/.env,把所有 CHANGE_ME 改成实际值
#   3) 权限: sudo chown guoyu:guoyu /data/guoyu/.env && sudo chmod 600 /data/guoyu/.env
#   4) 重启: sudo systemctl restart platform-api
# =============================================================================

# ---- Server ----
SERVER_PORT=8080

# ---- MySQL (同机自建) ----
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/gjjd_test?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=guoyu_app
MYSQL_PASSWORD=CHANGE_ME_mysql_password

# ---- Redis (同机自建) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DATABASE=0

# ---- JWT (32+ 字符随机串,生产必须重新生成) ----
JWT_SECRET=CHANGE_ME_64_char_random_string_at_least_32_chars_long_replace_me
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- CORS ----
# 公网 IP 模式:填 nginx 监听的源,例 http://1.2.3.4
# 多源逗号分隔,不能用 * 配合 allowCredentials=true
CORS_ALLOWED_ORIGINS=http://43.138.163.7

# ---- 文件存储 (cos | local) ----
FILE_STORAGE_PROVIDER=cos
FILE_LOCAL_ROOT=/data/guoyu/storage/files

# ---- 腾讯云 COS (已用你的凭证) ----
# 凭证在 https://console.cloud.tencent.com/cam/capi 创建子账号,授予 COS 读写权限
COS_SECRET_ID=AKIDwiHpAH9mAJEvNde8OO9j8QUJtFMD1bw2
COS_SECRET_KEY=rUu46wZx6YpvpW7nFSQBh192g5qjRxHP
COS_REGION=ap-guangzhou
COS_BUCKET=qlgysaas-1327842189
# 公网 URL 走 COS 默认 endpoint(腾讯云控制台请求域名给出)
COS_URL_PREFIX=https://qlgysaas-1327842189.cos.ap-guangzhou.myqcloud.com

# ---- 微信小程序 (Web 端不影响,先留默认) ----
WECHAT_MINI_APP_ID=wx67133f973ccd5592
WECHAT_MINI_APP_SECRET=a927524973ea144a9405b9739a2b2c51

# ---- Flowable (流程引擎) ----
FLOWABLE_DATABASE_SCHEMA_UPDATE=true

# ---- rencaishibie 人才识别（方案规划 / 三年规划必配）----
# 同机部署用 127.0.0.1；分机或本地开发连公网引擎可用 http://43.138.163.7:8001
RENCAI_ENABLED=true
RENCAI_BASE_URL=http://127.0.0.1:8001
# RENCAI_INTERNAL_TOKEN=

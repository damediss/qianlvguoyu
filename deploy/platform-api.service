[Unit]
Description=Guoyu Platform API (Spring Boot)
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=guoyu
Group=guoyu
WorkingDirectory=/data/guoyu

# 从 /data/guoyu/.env 读环境变量(SystemD EnvironmentFile 不会展开变量,
# 实际值由 deploy 脚本在启动前写入 /data/guoyu/.env 即可,Java -jar 直接读系统 env)
EnvironmentFile=/data/guoyu/.env

# JVM 调优
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
Environment=SPRING_PROFILES_ACTIVE=prod

ExecStart=/usr/bin/java \
  -Xms512m -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -Djava.security.egd=file:/dev/./urandom \
  -jar /data/guoyu/platform-api-0.1.0-SNAPSHOT.jar

Restart=always
RestartSec=5
SuccessExitStatus=143

# 安全加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/data/guoyu/storage /data/guoyu/logs

# 日志输出到 journald,生产可改 SyslogIdentifier
StandardOutput=journal
StandardError=journal
SyslogIdentifier=platform-api

[Install]
WantedBy=multi-user.target

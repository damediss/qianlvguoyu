# ============================================================
# PHP -> SaaS 三表同步任务（手机端调用SaaS鉴权方案 §3.5.3）
# PHP 库只读账号（infra/db/auth-token-sync-ops.sql 第 1 段创建，限来源 IP）
# 模板不落真实值，部署时按实际填写
#
# 注意：以下 *_ENABLED 仅生产服务器（43.138.163.7）置 true。
# 本机调试保持 false（application.yml 默认 false）——轮询会对 PHP 库做全表
# MD5 扫描（消耗其 CPU/IO）并产生跨公网流量，本机不应打 PHP 生产库。
# ============================================================
PLATFORM_SYNC_ENABLED=true
PLATFORM_SYNC_INTERVAL_MS=3000
PLATFORM_SYNC_INITIAL_DELAY_MS=10000
# user/detail 指纹比对节流间隔（水位线快路径仍每周期跑；token 表不受影响仍每周期对账）
PLATFORM_SYNC_FINGERPRINT_INTERVAL_MS=60000
PLATFORM_SYNC_BATCH_SIZE=500
PLATFORM_SYNC_FAIL_ALERT_THRESHOLD=20
# 试运行：true 时只读 PHP 库记录将发生的变更，不写镜像、不推进水位线
PLATFORM_SYNC_DRY_RUN=false
PLATFORM_SYNC_DAILY_CRON=0 30 3 * * *
# AI 同步学定时任务（同样读 PHP 库）：仅生产置 true
REVIEW_SYNC_JOBS_ENABLED=true
PHP_MYSQL_URL=jdbc:mysql://<PHP库主机>:3308/gjjddb?connectTimeout=3000&socketTimeout=10000&useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
PHP_MYSQL_USERNAME=
PHP_MYSQL_PASSWORD=
PHP_MYSQL_MAX_ACTIVE=3
PHP_MYSQL_MAX_WAIT_MS=3000
PHP_MYSQL_QUERY_TIMEOUT=10

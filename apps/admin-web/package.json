{
  "name": "guoyu-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "Chrome >= 80",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:competition-score": "esbuild tests/competitionScoreUtils.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/competitionScoreUtils.test.cjs && node --test node_modules/.cache/competitionScoreUtils.test.cjs",
    "test:competition-routes": "esbuild tests/competitionRoutes.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/competitionRoutes.test.cjs && node --test node_modules/.cache/competitionRoutes.test.cjs",
    "test:competition-stage-planning": "vitest run --config vitest.config.ts tests/competitionStagePlanning.test.ts tests/stagePlanningComponents.test.tsx",
    "test:e2e:stage-planning": "playwright test e2e/competition-stage-planning.spec.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@tanstack/react-query": "^5.62.11",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@xyflow/react": "^12.11.2",
    "antd": "^5.22.6",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "docx-preview": "^0.3.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "json-bigint": "^1.0.0",
    "markdown-it": "^14.3.0",
    "md-editor-rt": "^6.5.4",
    "pdfjs-dist": "^4.10.38",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.6",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/json-bigint": "^1.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}

PORT=3001
MCP_BEARER_TOKEN=change-me-inbound-mcp-bearer

# Upstream platform-api
PLATFORM_API_BASE_URL=http://localhost:8080/api

# Service account for auto login / 401 re-login (required)
# tenantCode is the code field (e.g. demo), NOT the display name (千铝工投)
PLATFORM_TENANT_CODE=demo
PLATFORM_API_USERNAME=admin
PLATFORM_API_PASSWORD=Admin@123456

# Optional bootstrap cache; leave empty to login on first request
# PLATFORM_API_TOKEN=
# PLATFORM_TENANT_ID=1

PLATFORM_REQUEST_TIMEOUT_MS=10000

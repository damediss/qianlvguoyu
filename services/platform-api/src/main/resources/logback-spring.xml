<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========== 属性 ========== -->
    <property name="LOG_PATH" value="./logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/platform.log"/>
    <property name="ERROR_FILE" value="${LOG_PATH}/error.log"/>

    <!-- 通用日志格式，含 %X{requestId} -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId}] %logger{36}.%M\(%line\) - %msg%n"/>
    <!-- 控制台彩色格式 -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%cyan(%X{requestId})] %yellow(%logger{36}.%M\(%line\)) - %msg%n"/>

    <!-- ========== 控制台（彩色） ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== 通用文件（按天滚动，30天，500MB/文件） ========== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/platform.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>15GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ========== 错误文件（只记 ERROR，立即 flush，90天） ========== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ERROR_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
            <immediateFlush>true</immediateFlush>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- ========== 异步文件（仅 prod 使用） ========== -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- ========== Profile: dev ========== -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

        <logger name="com.guoyu.platform.auth.controller" level="DEBUG"/>
        <logger name="com.guoyu.platform.exam.controller" level="DEBUG"/>
        <logger name="com.guoyu.platform.knowledge.controller" level="DEBUG"/>
        <logger name="com.guoyu.platform.system.controller" level="DEBUG"/>
        <logger name="com.guoyu.platform.exam.mapper" level="DEBUG"/>

        <logger name="org.springframework.web" level="WARN"/>
    </springProfile>

    <!-- ========== Profile: prod ========== -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

        <logger name="com.guoyu.platform.auth.controller" level="INFO"/>
        <logger name="com.guoyu.platform.exam.controller" level="INFO"/>
        <logger name="com.guoyu.platform.knowledge.controller" level="INFO"/>
        <logger name="com.guoyu.platform.system.controller" level="INFO"/>

        <logger name="org.springframework.web" level="WARN"/>
    </springProfile>

    <!-- ========== 默认（无 profile）= 等同 dev ========== -->
    <springProfile name="!dev">
        <springProfile name="!prod">
            <root level="DEBUG">
                <appender-ref ref="CONSOLE"/>
                <appender-ref ref="FILE"/>
                <appender-ref ref="ERROR_FILE"/>
            </root>

            <logger name="com.guoyu.platform.auth.controller" level="DEBUG"/>
            <logger name="com.guoyu.platform.exam.controller" level="DEBUG"/>
            <logger name="com.guoyu.platform.knowledge.controller" level="DEBUG"/>
            <logger name="com.guoyu.platform.system.controller" level="DEBUG"/>
            <logger name="com.guoyu.platform.exam.mapper" level="DEBUG"/>

            <logger name="org.springframework.web" level="WARN"/>
        </springProfile>
    </springProfile>

</configuration>

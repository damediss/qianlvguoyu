import { createStore } from 'vuex'

export default createStore({
	state:{
		count: 0,
		userInfo: {
			id:0,
			realname:'',
			idcard:'',
			gender:0,
			work_type_id:0,
			work_type:'',
			type:-1,
			qmlp_id:0,
			company_id:0
		}
	},
	mutations:{
		setUserInfo(state, {key,val}) {
			state.userInfo[key] = val;
		},
		replaceUserInfo(state, val) {
			state.userInfo = val;
		}
	},
	actions:{
		async fetchUser({ commit }) {
		    //const user = await uni.request({ url: '/api/user' });
			const user = {realname:'Hi',idcard:'999',gender:0};
		    commit('replaceUserInfo', user);
		}
	}
});

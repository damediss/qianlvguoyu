# Isolated formal-exam load environment. Copy to .env and keep out of git.
# These values are synthetic load-test credentials, not production secrets.

COMPOSE_PROJECT_NAME=formal-exam-load

LOAD_MYSQL_PORT=13306
LOAD_MYSQL_USER=gjjd_load
LOAD_MYSQL_PASSWORD=LoadTest_Db_Only
LOAD_MYSQL_ROOT_PASSWORD=LoadTest_Root_Only
LOAD_MYSQL_DATABASE=gjjddb_load

LOAD_REDIS_PORT=16379
LOAD_RABBIT_PORT=15671
LOAD_RABBIT_MGMT_PORT=15673
LOAD_RABBIT_USER=load
LOAD_RABBIT_PASSWORD=LoadTest_Mq_Only
LOAD_PROXY_PORT=18080

API_1_PORT=18081
API_2_PORT=18082

# Host-side JVM caps for the two isolated API nodes. The previous default
# reserved roughly 4 GB max heap per process on this 16 GB workstation and
# api-2 hit native OOM during the 100 Pad run. Node-specific API_1_* / API_2_*
# overrides are supported by ctl.mjs when a comparison run needs them.
FORMAL_EXAM_API_XMS=256m
FORMAL_EXAM_API_XMX=1024m
FORMAL_EXAM_API_XSS=512k
FORMAL_EXAM_API_MAX_METASPACE=384m
FORMAL_EXAM_API_MAX_DIRECT_MEMORY=256m
FORMAL_EXAM_API_CODE_CACHE=128m

MYSQL_URL=jdbc:mysql://127.0.0.1:13306/gjjddb_load?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&connectTimeout=5000&socketTimeout=60000&tcpKeepAlive=true
MYSQL_USERNAME=gjjd_load
MYSQL_PASSWORD=LoadTest_Db_Only
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15671
RABBITMQ_USERNAME=load
RABBITMQ_PASSWORD=LoadTest_Mq_Only
JWT_SECRET=loadtest-only-change-me-loadtest-only-xx
SPRING_PROFILES_ACTIVE=loadtest
FILE_LOCAL_ROOT=./scripts/formal-exam-load/.run/files
FILE_STORAGE_PROVIDER=local

# Dual confirmation required before pads>10 or any answer writes.
FORMAL_EXAM_LOAD_ALLOW_LARGE=0
FORMAL_EXAM_LOAD_ISOLATED=

LOAD_TENANT_ID=10159
LOAD_TENANT_CODE=loadtest
LOAD_CONSOLE_PASSWORD=Admin@123456
LOAD_PLAYER_PASSWORD=LoadTest#123
